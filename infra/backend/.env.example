# Environment variables for Backend Compute Instance
# Copy this file to infra/backend/.env on the Backend VM and fill in your values.

# --- Core Settings ---
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-me-to-a-64-character-random-hex-string
APP_NAME=NetPnL
API_PREFIX=/api/v1

# --- Database Connection (Oracle MySQL Database Service) ---
# Replace with your MySQL DB instance private IP, port, database name, user, and password:
# e.g.: mysql+asyncmy://admin:SecretPassword123@10.0.1.25:3306/netpnl?charset=utf8mb4
DATABASE_URL=mysql+asyncmy://<DB_USER>:<DB_PASSWORD>@<MYSQL_PRIVATE_IP>:3306/<DB_NAME>?charset=utf8mb4
AUTO_CREATE_TABLES=false
SQL_ECHO=false

# --- Authentication & Security ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS & URLs ---
# In production with Nginx reverse proxy, frontend and API share retailtraders.duckdns.org
PUBLIC_SITE_URL=https://retailtraders.duckdns.org
API_PUBLIC_URL=https://retailtraders.duckdns.org
CORS_ORIGINS=https://retailtraders.duckdns.org,http://retailtraders.duckdns.org

# --- Broker Integrations ---
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://retailtraders.duckdns.org/settings/brokers/callback

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=https://retailtraders.duckdns.org/settings/brokers/callback

ANGEL_ONE_API_KEY=
ANGEL_ONE_REDIRECT_URI=https://retailtraders.duckdns.org/settings/brokers/callback

# --- UPI Penny Drop Verification ---
UPI_PROVIDER=mock
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Background Sync ---
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30

