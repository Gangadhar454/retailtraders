# Copy to infra/.env and fill in before running docker compose.
# Every value here is read by infra/docker-compose.yml.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------------
POSTGRES_USER=netpnl
POSTGRES_PASSWORD=netpnl
POSTGRES_DB=netpnl
POSTGRES_PORT=5432

# --- Ports ------------------------------------------------------------------
# NEXT_PUBLIC_API_URL is compiled into the browser bundle, so it must be the
# address the browser can reach (not the internal Docker hostname).
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Tokens -----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Brokers ----------------------------------------------------------------
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/settings/brokers/callback
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=http://localhost:3000/settings/brokers/callback

# --- UPI penny drop: mock | cashfree | razorpay ----------------------------
UPI_PROVIDER=mock
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Background broker sync -------------------------------------------------
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30
