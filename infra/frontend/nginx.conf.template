# Production Nginx reverse proxy for retailtraders.in

# Map real client IP for rate limiting (prefers CF-Connecting-IP from Cloudflare, falls back to direct IP)
map $http_cf_connecting_ip $rate_limit_ip {
    ""      $binary_remote_addr;
    default $http_cf_connecting_ip;
}

# DDoS & Rate Limiting Zones (Shared memory in http context)
# 10MB zone tracks ~160,000 unique client IP states
limit_req_zone $rate_limit_ip zone=rt_api_general:10m rate=30r/s;
limit_req_zone $rate_limit_ip zone=rt_api_auth:10m rate=5r/s;
limit_conn_zone $rate_limit_ip zone=rt_addr_conn:10m;

# Return HTTP 429 Too Many Requests on rate limit
limit_req_status 429;
limit_conn_status 429;

# Plain HTTP (port 80)
server {
    listen 80;
    listen [::]:80;
    server_name retailtraders.in www.retailtraders.in _;

    # Allow Let's Encrypt ACME challenges
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Internal proxy for Angel One SmartAPI (relays through frontend's working IP)
    location /angelone-proxy/ {
        allow 10.0.0.0/16;
        allow 127.0.0.1;
        deny all;

        proxy_pass https://apiconnect.angelone.in/;
        proxy_ssl_server_name on;
        proxy_set_header Host apiconnect.angelone.in;
        proxy_set_header Accept-Encoding "";
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location / {
        return 301 https://retailtraders.in$request_uri;
    }
}

# HTTPS server for retailtraders.in (Primary Site)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name retailtraders.in;

    ssl_certificate /etc/letsencrypt/live/retailtraders.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/retailtraders.in/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Modern SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Security headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Limit concurrent connections per IP (mitigate Slowloris / connection exhaustion)
    limit_conn rt_addr_conn 50;

    # Route 1a: Sensitive Auth Endpoints (Brute-force, credential stuffing & OTP spam protection)
    location /api/v1/auth/ {
        limit_req zone=rt_api_auth burst=10 nodelay;

        proxy_pass http://10.0.0.129:8000/api/v1/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Route 1b: General API requests -> Backend VM via OCI private network (DDoS & flood protection)
    location /api/ {
        limit_req zone=rt_api_general burst=60 nodelay;

        proxy_pass http://10.0.0.129:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Clean JSON error response for rate limited requests
    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/json;
        return 429 '{"detail":"Too many requests. Please wait a moment before trying again."}';
    }

    # Route 2: Web frontend -> Local Next.js container (:3000)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }
}
