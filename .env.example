# Root-level convenience template. The real configuration lives in
# backend/.env and infra/.env — see README.md.

# Base URL of the API, used by the frontend build.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Shared secret that signs JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
