# ---- Core ----------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
PUBLIC_SITE_URL=http://localhost:3000

# ---- Database ------------------------------------------------------------
# Production (AWS RDS Postgres):
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/netpnl
DATABASE_URL=sqlite+aiosqlite:///./netpnl.db
AUTO_CREATE_TABLES=true

# ---- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Tokens ---------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Upstox --------------------------------------------------------------
# Live: register an app at https://upstox.com/developer/api-documentation and
# paste the API key and secret here. Register the redirect URL exactly as
# written below. Traders then sign in on Upstox's own login page and we read
# today's realised P&L from their positions. These are one-time app credentials.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/settings/brokers/callback

# ---- Zerodha (Kite Connect v3) -------------------------------------------
# Create an app at https://developers.kite.trade, then paste its API key and
# secret here. Register the redirect URL below exactly. Kite sessions expire at
# 6 AM IST, so traders reconnect each morning.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=http://localhost:3000/settings/brokers/callback

# ---- Angel One SmartAPI ---------------------------------------------------
# Set this to a public HTTPS backend URL and register the exact same URL in
# SmartAPI. For local development, use an HTTPS tunnel to port 8010.
ANGEL_ONE_API_KEY=
ANGEL_ONE_REDIRECT_URI=
# SmartAPI requires the API server's network identity on each request.
ANGEL_ONE_CLIENT_LOCAL_IP=
ANGEL_ONE_CLIENT_PUBLIC_IP=
ANGEL_ONE_MAC_ADDRESS=

# ---- UPI penny drop ------------------------------------------------------
# mock | cashfree | razorpay
UPI_PROVIDER=mock
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PENNY_DROP_AMOUNT=1

# ---- Background sync -----------------------------------------------------
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30
